        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponses courtes avec un petit budget de sortie. Le plus rapide."
          }
        }
      }
    },
    "The default output budget for most conversations.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le budget de sortie par défaut pour la plupart des conversations."
          }
        }
      }
    },
    "Room for long answers, patches, and explanations.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace pour les réponses longues, les correctifs et les explications."
          }
        }
      }
    },
    "Ask before high-impact tools": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander avant les outils à fort impact"
          }
        }
      }
    },
    "Never ask": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais demander"
          }
        }
      }
    },
    "Running commands, editing files, and controlling the desktop require approval.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécution de commandes, la modification de fichiers et le contrôle du bureau nécessitent une approbation."
          }
        }
      }
    },
    "Tools run automatically inside the sandbox you choose.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils s’exécutent automatiquement dans le bac à sable choisi."
          }
        }
      }
    },
    "Read only": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule"
          }
        }
      }
    },
    "Workspace write": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écriture dans l’espace de travail"
          }
        }
      }
    },
    "Full access": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès complet"
          }
        }
      }
    },
    "Read files and run read-only commands. Writes are blocked.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire les fichiers et exécuter les commandes en lecture seule. Les écritures sont bloquées."
          }
        }
      }
    },
    "Read and write inside the workspace and temporary folders.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire et écrire dans l'espace de travail et les dossiers temporaires."
          }
        }
      }
    },
    "No filesystem sandbox. Only use this when you trust the task.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun sandbox de système de fichiers. N'utilisez cette option que si vous faites confiance à la tâche."
          }
        }
      }
    },
    "The project folder is the workspace for shell, file, search, and document tools.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier du projet est l’espace de travail des outils shell, fichiers, recherche et documents."
          }
        }
      }
    },
    "Anthropic count_tokens, Gemini countTokens, and Ollama prompt_eval give exact context counts for non-BPE models.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic count_tokens, Gemini countTokens et Ollama prompt_eval donnent des nombres de contextes exacts pour les modèles non-BPE."
          }
        }
      }
    },
    "Allow network access for shell commands and web tools": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l'accès au réseau pour les commandes shell et les outils Web"
          }
        }
      }
    },
    "Maximum tool steps: %lld": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre maximal d’étapes de l’outil : %lld"
          }
        }
      }
    },
    "Runs a read-only reviewer in a separate context and shows its recommendation in the approval sheet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute un réviseur en lecture seule dans un contexte séparé et affiche sa recommandation dans la feuille d’approbation."
          }
        }
      }
    },
    "No profiles yet. Save the current model, sandbox, approval, and tool settings as a profile.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun profil pour le moment. Enregistrez les réglages actuels du modèle, du bac à sable, des approbations et des outils en tant que profil."
          }
        }
      }
    },
    "Applying a profile switches the model, reasoning, sandbox, approvals, network, speed, and tool toggles.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application d'un profil modifie le modèle, le raisonnement, le bac à sable, les approbations, le réseau, la vitesse et les options d'activation/désactivation des outils."
          }
        }
      }
    },
    "Hook commands run through zsh in the workspace. They receive event details as JSON on stdin and as TALOS_* environment variables. Untrusted hooks ask before running.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes de hook s’exécutent via zsh dans l’espace de travail. Elles reçoivent les détails de l’événement au format JSON sur stdin et sous la forme de variables d’environnement TALOS_*. Les hooks non approuvés demandent une confirmation avant de s’exécuter."
          }
        }
      }
    },
    "Enabled memories and active goals are added to the system prompt for every model. Disabled and completed items stay visible here but are not sent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les souvenirs activés et les objectifs actifs sont ajoutés à l’invite système pour chaque modèle. Les éléments désactivés et terminés restent visibles ici, mais ne sont pas envoyés."
          }
        }
      }
    },
    "Managed policies are read-only. MDM values from the managed preferences domain override a signed or local file field by field. A signed file is verified with an Ed25519 key from policy.pub or TALOS_POLICY_PUBLIC_KEY. Local unsigned files are accepted only from the managed search paths or an explicit TALOS_POLICY_FILE.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les politiques gérées sont en lecture seule. Les valeurs MDM du domaine des préférences gérées remplacent un fichier signé ou local, champ par champ. Un fichier signé est vérifié avec une clé Ed25519 provenant de policy.pub ou de TALOS_POLICY_PUBLIC_KEY. Les fichiers locaux non signés ne sont acceptés qu’à partir des chemins de recherche gérés ou d’un TALOS_POLICY_FILE explicite."
          }
        }
      }
    },
    "Task server": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur de tâches"
          }
        }
      }
    },
    "Enable the self-hosted task server": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le serveur de tâches auto-hébergé"
          }
        }
      }
    },
    "Allow connections from the local network": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les connexions depuis le réseau local"
          }
        }
      }
    },
    "Workers authenticate with Authorization: Bearer <token>. The server is bound to localhost unless LAN access is enabled.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les workers s’authentifient avec Authorization: Bearer <token>. Le serveur est lié à localhost sauf si l’accès au réseau local est activé."
          }
        }
      }
    },
    "The worker claims one task at a time, creates an isolated git worktree, and runs the task with shell and file tools.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worker prend une tâche à la fois, crée un worktree git isolé et exécute la tâche avec les outils shell et fichiers."
          }
        }
      }
    },
    "Cancelling a task takes effect before it starts or when the worker finishes its current step.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'annulation d'une tâche prend effet avant son démarrage ou lorsque l'opérateur termine son étape en cours."
          }
        }
      }
    },
    "Describe the change to make in %@...": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez la modification à apporter dans %@..."
          }
        }
      }
    },
    "Enable the local app server": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le serveur d'applications local"
          }
        }
      }
    },
    "Headless clients authenticate with Authorization: Bearer <token> or ?token=. The server binds to localhost unless LAN access is enabled. Set TALOS_APP_SERVER=1 to start it at launch for automation.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clients sans interface graphique s’authentifient avec Authorization: Bearer <token> ou ?token=. Le serveur se lie à localhost, sauf si l'accès au réseau local est activé. Définissez TALOS_APP_SERVER=1 pour le démarrer au lancement afin de l'automatiser."
          }
        }
      }
    },
    "Add a folder containing SKILL.md under %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier contenant SKILL.md sous %@."
          }
        }
      }
    },
    "Skills are reusable instructions. Every model sees their names and descriptions, and can load one with the read_skill tool.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compétences sont des instructions réutilisables. Chaque modèle voit leur nom et leur description, et peut en charger une avec l’outil read_skill."
          }
        }
      }
    },
    "Add a folder with plugin.json under %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un dossier contenant plugin.json sous %@."
          }
        }
      }
    },
    "A plugin can bundle skills and stdio MCP servers. Enabled plugins add their skills and tools to every model.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plugin peut regrouper des compétences et des serveurs stdio MCP. Les plugins activés ajoutent leurs compétences et leurs outils à chaque modèle."
          }
        }
      }
    },
    "Ed25519 public key (base64)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé publique Ed25519 (base64)"
          }
        }
      }
    },
    "Remote catalogs must be a signed envelope with base64 payload and Ed25519 signature. Plugin sources must be zip archives with a SHA-256 digest in the signed catalog.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catalogues distants doivent être une enveloppe signée avec une charge utile base64 et une signature Ed25519. Les sources des plugins doivent être des archives zip avec un condensé SHA-256 dans le catalogue signé."
          }
        }
      }
    },
    "Add a catalog JSON file under %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un fichier JSON de catalogue sous %@."
          }
        }
      }
    },
    "Catalogs are local JSON files. Installing copies the plugin folder into Talos; updates replace it; removing deletes the.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catalogues sont des fichiers JSON locaux. L’installation copie le dossier du plugin dans Talos ; les mises à jour le remplacent ; la suppression supprime le."
          }
        }
      }
    },
    "Average %@ per active day": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyenne de %@ par jour actif"
          }
        }
      }
    },
    "Peak %@ on %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pic %@ sur %@"
          }
        }
      }
    },
    "Keep local model loaded": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le modèle local chargé"
          }
        }
      }
    },
    "Longer keeps avoid reloading a local model between messages.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des durées de conservation plus longues évitent de recharger un modèle local entre les messages."
          }
        }
      }
    },
    "When estimated context reaches this share of the model window, Talos summarizes older messages with the same model before continuing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque le contexte estimé atteint cette part de la fenêtre du modèle, Talos résume les messages plus anciens avec le même modèle avant de continuer."
          }
        }
      }
    },
    "New worktrees use this prefix, for example talos/task.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux arbres de travail utilisent ce préfixe, par exemple talos/task."
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        }
      }
    },
    "Local models stay on this Mac. Hosted requests go only to the provider you configure. Talos does not train on your conversations.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles locaux restent sur ce Mac. Les requêtes hébergées ne sont envoyées qu'au fournisseur que vous configurez. Talos ne s'entraîne pas sur vos conversations."
          }
        }
      }
    },
    "Cloud": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud"
          }
        }
      }
    },
    "Shell, file, web, plan, and computer tools are available with every model. Configure them in Tools.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils shell, fichiers, web, plan et ordinateur sont disponibles avec chaque modèle. Configurez-les dans Outils."
          }
        }
      }
    },
    "Some counts are estimated from text length because the provider did not report usage.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains décomptes sont estimés à partir de la longueur du texte car le fournisseur n’a pas signalé l’utilisation."
          }
        }
      }
    },
    "Responses are JSON-RPC 2.0. Start a run with session.prompt and watch GET /events?sessionId=… for SSE notifications.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses sont JSON-RPC 2.0. Démarrez une exécution avec session.prompt et surveillez GET /events?sessionId=… pour les notifications SSE."
          }
        }
      }
    },
    "%lld models found": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld modèles trouvés"
          }
        }
      }
    },
    "%lld catalog plugins": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld plugins du catalogue"
          }
        }
      }
    },
    "Add a catalog JSON file under %@. Sources must be local plugin folders containing plugin.json.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un fichier JSON de catalogue sous %@. Les sources doivent être des dossiers de plugins locaux contenant plugin.json."
          }
        }
      }
    },
    "Describe the change to make in %@…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez la modification à apporter dans %@…"
          }
        }
      }
    },
    "Loaded %lld signed plugins": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld plugins signés chargés"
          }
        }
      }
    },
    "Unreadable": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Illisible"
          }
        }
      }
    },
    "Signed (Ed25519)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signé (Ed25519)"
          }
        }
      }
    },
    "Local file (unsigned)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier local (non signé)"
          }
        }
      }
    },
    "Rejected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeté"
          }
        }
      }
    },
    "Managed preferences (MDM)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférences gérées (MDM)"
          }
        }
      }
    },
    "Context unknown": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexte inconnu"
          }
        }
      }
    },
    "%@ / %@ context": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@ contexte"
          }
        }
      }
    },
    "%lld tokens": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jetons"
          }
        }
      }
    },
    "%lld saved · injected into every task": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld enregistré · injecté dans chaque tâche"
          }
        }
      }
    },
    "%lld active · %lld completed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld actif(s) · %lld terminé(s)"
          }
        }
      }
    },
    "The worker claims one task at a time, creates an isolated git worktree, and runs the task with shell and file tools. Cancelling a task takes effect before it starts or when the worker finishes its current step.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worker prend une tâche à la fois, crée un worktree git isolé et exécute la tâche avec les outils shell et fichiers. L’annulation d’une tâche prend effet avant son démarrage ou lorsque le worker termine son étape en cours."
          }
        }
      }
    },
    "OpenCode Go reasoning effort.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode Go effort de raisonnement."
          }
        }
      }
    },
    "%lld local": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld local"
          }
        }
      }
    },
    " · %lld cloud": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld cloud"
          }
        }
      }
    },
    "For browser_cdp, start Chrome with --remote-debugging-port=9222 (or the port above) and keep a tab open. Accessibility control still works without it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour browser_cdp, démarrez Chrome avec --remote-debugging-port=9222 (ou le port ci-dessus) et gardez un onglet ouvert. Le contrôle de l'accessibilité fonctionne toujours sans cela."
          }
        }
      }
    },
    "Detected language servers: ": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveurs de langage détectés : "
          }
        }
      }
    },
    "available": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "disponible"
          }
        }
      }
    },
    "missing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "manquant"
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais"
          }
        }
      }
    },
    "App Server Task": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tâche du serveur d'applications"
          }
        }
      }
    },
    "Starting…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrage…"
          }
        }
      }
    },
    "App server port": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Port du serveur d’applications"
          }
        }
      }
    },
    "Example": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple"
          }
        }
      }
    },
    "Behavior": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comportement"
          }
        }
      }
    },
    "Trusted (run without confirmation)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvé (exécution sans confirmation)"
          }
        }
      }
    },
    "Dismiss suggestion": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeter la suggestion"
          }
        }
      }
    },
    "Ambient suggestions": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions contextuelles"
          }
        }
      }
    },
    "Record local activity history": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer l'historique des activités locales"
          }
        }
      }
    },
    "Generate ambient suggestions": {
      "localizations": {
        "fr": {
          "stringUnit": {
