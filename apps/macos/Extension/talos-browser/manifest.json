{
  "manifest_version": 3,
  "name": "Talos Browser Bridge",
  "version": "1.0.0",
  "description": "Send the current page or selection to Talos and ask about it.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Talos",
    "default_popup": "popup.html"
  }
}
